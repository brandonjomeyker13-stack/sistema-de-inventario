# .env.ejemplo — Plantilla de configuración.
#
# Copia este archivo como `.env` y rellena los valores. El `.env` real
# NUNCA se sube al repositorio (está en .gitignore): contiene la
# contraseña de la base y las claves de los servicios.
#
# Solo DATABASE_URL y SECRET_KEY son obligatorias. Todo lo demás tiene
# valor por defecto y la API arranca sin ello — las funciones que
# dependan de una clave ausente devuelven un error claro en vez de fallar
# al iniciar.


# ─── OBLIGATORIAS ──────────────────────────────────────────────────────

# Supabase -> Project Settings -> Database -> Connection string.
#
# Puerto 6543 (transaction mode) para la API en marcha: es lo que espera
# el NullPool de database/session.py.
# Puerto 5432 (session mode) para correr `alembic`, que hace DDL.
#
# Si la contraseña tiene caracteres especiales hay que escaparlos
# (@ -> %40). Lo más simple es usar una contraseña solo alfanumérica.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Firma de los JWT. Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambias, todas las sesiones abiertas dejan de valer.
SECRET_KEY=


# ─── CORREO (Resend) ───────────────────────────────────────────────────

# resend.com -> API Keys. Sin esto el registro funciona igual, pero no
# se manda ningún correo.
RESEND_API_KEY=

# El valor de abajo funciona SIN verificar ningún dominio, pero solo
# envía al correo con el que creaste la cuenta de Resend. Sirve para
# comprobar que el flujo funciona mientras esperas el DNS.
#
# Cuando el dominio esté verificado en Resend, cámbialo por el tuyo:
#   CORREO_REMITENTE=StockTrack <noreply@tudominio.com>
#
# Un remitente de un dominio SIN verificar hace que Resend rechace el
# envío: la cuenta se crea igual y no llega ningún correo, sin error a la
# vista. Por eso el valor por probar va primero.
CORREO_REMITENTE=StockTrack <onboarding@resend.dev>

# A dónde apuntan los enlaces de los correos. Debe ser el FRONTEND, no la
# API: quien abre un correo espera una pantalla, no un JSON.
# El frontend tiene que atender /verificar?token=... y /restablecer?token=...
URL_FRONTEND=https://stocktrack-ai.lovable.app

# Si es true, nadie entra sin confirmar su correo.
# DÉJALO EN false hasta comprobar que los correos llegan de verdad; si lo
# activas antes, nadie podrá iniciar sesión.
REQUERIR_EMAIL_VERIFICADO=false


# ─── INICIAR SESIÓN CON GOOGLE ─────────────────────────────────────────

# Google Cloud -> APIs & Services -> Credentials -> OAuth client ID,
# tipo "Web application".
# NO es una cuenta de servicio, y NO hace falta el Client Secret: el
# flujo del navegador solo usa el ID.
GOOGLE_CLIENT_ID=


# ─── ASISTENTE DE IA (Groq) ────────────────────────────────────────────

# console.groq.com -> API Keys
GROQ_API_KEY=

# El modelo va aquí y no en el código porque Groq rota y deprecia
# modelos. Verifica el nombre exacto en console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b


# ─── OPCIONALES (tienen buen valor por defecto) ────────────────────────

# Zona horaria del negocio. Decide qué se considera "hoy" al registrar
# una venta. Sin esto el servidor usaría UTC y las ventas de la noche
# caerían en el día siguiente.
ZONA_HORARIA=America/Bogota

# Dominios permitidos para llamar a la API, separados por coma.
CORS_ORIGINS=https://stocktrack-ai.lovable.app,http://localhost:3000

# Duración de los tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
